# Copy to .env and uncomment what you want to change; `docker compose up -d --wait` picks it up.
# The values shown are the defaults baked into compose.yaml and tools/serve.sh.

# Tokens Clover drafts per step: a divisor of the checkpoint's block size of 32 (2, 4, 8, 16 or 32). Single stream
# on the Spark (code / English / Dutch tok/s): 32 gives 90/26/25, 16 gives 84/33/27, 8 gives 63/40/31, 2 gives 28/29/29.
#DRAFT_TOKENS=16
# How drafted tokens are accepted. threshold: when the verify pass gives them enough probability (the default, fast).
# exact: only when they match the verify pass's argmax. Neither is lossless sampling: drafts are argmax, and
# temperature/top_p apply to the bonus token only.
#ACCEPT_RULE=threshold

# Context window (native: 131072 tokens, prompt and output together).
#CONTEXT=131072
# Requests served at once, and the decode batch sizes captured as CUDA graphs.
#PARALLEL=4
#CUDA_GRAPH_BS=1 2 4
# Share of the 121.6 GiB the Spark's GPU sees that SGLang takes for weights (69 GB) plus KV cache and state.
#MEM_FRACTION=0.75

#SERVED_NAME=clover
#HOST=0.0.0.0
#PORT=8888
# Set to require a bearer token on the API.
#API_KEY=

#MODEL_ID=Diffuspace/Clover-35B-A3B-Preview
#MODEL_REVISION=4b0402b65e523d0183a14c431955438714cb16ff
# The Clover PR branch (WilliamZR/sglang feature/clover-support), checked out over the SGLang nightly.
#SGLANG_COMMIT=058939af24d5cdc44bb4b8852d0ddfab555ed71e
#CLOVER_IMAGE=clover-sglang:058939af

#MODEL_DIR=~/.cache/clover
# Only needed if the model ever becomes gated.
#HF_TOKEN=
